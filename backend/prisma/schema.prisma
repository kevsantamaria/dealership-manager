generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(255)
  password  String
  role      Role     @default(user)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("users")
}

model Supplier {
  id        Int          @id @default(autoincrement())
  name      String       @db.VarChar(255)
  email     String?      @db.VarChar(255)
  telephone String?      @db.VarChar(255)
  type      SupplierType @default(private)
  country   String?      @db.VarChar(255)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamp(0)
  vehicles  Vehicle[]

  @@map("suppliers")
}

model Brand {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(255)
  countryOrigin String   @map("country_origin") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  models        Model[]

  @@map("brands")
}

model Model {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  launchYear Int      @map("launch_year")
  brandId    Int      @map("brand_id")
  brand      Brand    @relation(fields: [brandId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  trims      Trim[]

  @@map("models")
}

model Trim {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(255)
  engineSize   Int          @map("engine_size")
  horsepower   Int
  engineType   EngineType   @default(gasoline) @map("engine_type")
  transmission Transmission @default(automatic)
  drivetrain   Drivetrain   @default(fwd)
  modelId      Int          @map("model_id")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamp(0)
  model        Model        @relation(fields: [modelId], references: [id])
  vehicles     Vehicle[]

  @@map("trims")
}

model Vehicle {
  id              Int           @id @default(autoincrement())
  vin             String        @unique @db.VarChar(17)
  licensePlate    String?       @map("license_plate") @db.VarChar(255)
  color           String        @db.VarChar(255)
  mileage         Int?
  arrivalDate     DateTime      @map("arrival_date") @db.Date
  purchasePrice   Int           @map("purchase_price")
  suggestedPrice  Int           @map("suggested_price")
  stockStatus     StockStatus   @default(in_stock) @map("stock_status")
  rateCondition   RateCondition @default(good) @map("rate_condition")
  rateDescription String?       @map("rate_description") @db.VarChar(255)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamp(0)
  trimId          Int           @map("trim_id")
  trim            Trim          @relation(fields: [trimId], references: [id])
  supplierId      Int           @map("supplier_id")
  supplier        Supplier      @relation(fields: [supplierId], references: [id])
  image           Image?

  @@map("vehicles")
}

model Image {
  id        Int     @id @default(autoincrement())
  path      String  @db.VarChar(255)
  vehicleId Int     @unique @map("vehicle_id")
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  @@map("images")
}

enum Role {
  user
  admin
}

enum SupplierType {
  private
  dealer
  auction
  importer
  fleet
}

enum EngineType {
  gasoline
  diesel
  hybrid
  electric
}

enum Transmission {
  automatic
  manual
  cvt
}

enum Drivetrain {
  fwd
  rwd
  awd
}

enum StockStatus {
  in_stock
  reserved
  sold
}

enum RateCondition {
  bad
  regular
  good
  excellent
}
